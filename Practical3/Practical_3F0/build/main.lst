 141:Core/Src/main.c **** 				HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0 | GPIO_PIN_1,
 142:Core/Src/main.c **** 						GPIO_PIN_RESET); // reset LEDS for next cycle
 143:Core/Src/main.c **** 			}
 144:Core/Src/main.c **** 		}
 145:Core/Src/main.c **** 		if (run_Count) {
 146:Core/Src/main.c **** 			// Added to distinguish between which mode is running
 147:Core/Src/main.c **** 			state = false; //False implies double method is in use
